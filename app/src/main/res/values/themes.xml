<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- REPLATE Material 3 Green Theme (Light) -->
    <style name="Theme.REPLATE" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/md_theme_primary</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_onPrimaryContainer</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/md_theme_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_onSecondaryContainer</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/md_theme_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_onTertiaryContainer</item>

        <!-- Error -->
        <item name="colorError">@color/md_theme_error</item>
        <item name="colorOnError">@color/md_theme_onError</item>
        <item name="colorErrorContainer">@color/md_theme_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_onErrorContainer</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/md_theme_background</item>
        <item name="colorOnBackground">@color/md_theme_onBackground</item>
        <item name="colorSurface">@color/md_theme_surface</item>
        <item name="colorOnSurface">@color/md_theme_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_onSurfaceVariant</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_outlineVariant</item>

        <!-- Inverse -->
        <item name="colorSurfaceInverse">@color/md_theme_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_inversePrimary</item>

        <!-- Surface Tint -->
        <item name="colorSurfaceContainerLowest">@color/md_theme_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_theme_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_theme_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_theme_surfaceContainerHighest</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/surface_white</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/md_theme_background</item>

        <!-- Activity transitions — smooth slide -->
        <item name="android:windowAnimationStyle">@style/WindowAnimationTransition</item>

        <!-- Typography system -->
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.REPLATE.Headline</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.REPLATE.Subheading</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.REPLATE.Body</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.REPLATE.Label</item>

        <!-- Component consistency -->
        <item name="materialCardViewStyle">@style/Widget.REPLATE.Card</item>
        <item name="materialButtonStyle">@style/Widget.REPLATE.Button.Primary</item>
        <item name="textInputStyle">@style/Widget.REPLATE.TextInputLayout</item>
        <item name="editTextStyle">@style/Widget.REPLATE.TextInputEditText</item>
    </style>

    <!-- Window animation style for smooth transitions -->
    <style name="WindowAnimationTransition" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- Splash Screen Theme -->
    <!-- Shown by the system (Android 12+ native splash, older versions via the compat library)
         while the app starts, then handed over to Theme.REPLATE.PostSplash. -->
    <style name="Theme.REPLATE.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D3B1E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.REPLATE.PostSplash</item>
    </style>

    <!-- What the custom splash screen itself runs under -->
    <style name="Theme.REPLATE.PostSplash" parent="Theme.REPLATE">
        <item name="android:statusBarColor">@color/leaf</item>
        <item name="android:windowBackground">@color/leaf</item>
    </style>

    <!-- Bottom Nav Active Indicator -->
    <style name="Widget.REPLATE.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/md_theme_primaryContainer</item>
    </style>

    <!-- Prompt Specific Theme (backward compat) -->
    <style name="Theme.Replate" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorSecondary">@color/orange_accent</item>
        <item name="android:colorBackground">@color/background_cream</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <!-- Circular FAB shape for chat send button -->
    <style name="ShapeAppearance.REPLATE.CircleFab" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>

