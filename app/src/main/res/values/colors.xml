    <color name="md_theme_secondaryContainer">#E0F5E8</color>
    <color name="md_theme_onSecondaryContainer">#0D3B1E</color>

    <!-- Tertiary — Ember -->
    <color name="md_theme_tertiary">@color/ember</color>
    <color name="md_theme_onTertiary">#FFFFFF</color>
    <color name="md_theme_tertiaryContainer">#FFDBC9</color>
    <color name="md_theme_onTertiaryContainer">#5C1A00</color>

