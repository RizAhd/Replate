         Legacy color names (backward compat)
         ========================================== -->
    <color name="primary">@color/leaf</color>
    <color name="primary_dark">#0D3B1E</color>
    <color name="primary_light">@color/leaf_pale</color>
    <color name="text_primary">#1C1C1E</color>
    <color name="text_secondary">#6C6C6E</color>
