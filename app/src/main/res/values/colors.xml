    <color name="overlay_white_10">#1AFFFFFF</color>
    <color name="overlay_white_12">#1FFFFFFF</color>
    <color name="overlay_white_15">#26FFFFFF</color>
    <color name="scrim_white_40">#66FFFFFF</color>
    <color name="divider_soft">#0D000000</color>
    <color name="divider_softer">#0A000000</color>
