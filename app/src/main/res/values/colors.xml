<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==========================================
         REPLATE Design System · v2 Premium Polish
         Leaf #1A6B3C · Ember #E8521A · Neutral #FAFAFA
         ========================================== -->

    <!-- Primary — Leaf -->
    <color name="md_theme_primary">@color/leaf</color>
    <color name="md_theme_onPrimary">#FFFFFF</color>
    <color name="md_theme_primaryContainer">#E0F5E8</color>
    <color name="md_theme_onPrimaryContainer">#0D3B1E</color>

    <!-- Secondary — Leaf2 -->
    <color name="md_theme_secondary">@color/leaf2</color>
