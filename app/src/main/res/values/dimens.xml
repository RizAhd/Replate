<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spacing: 4dp grid. Use these instead of raw dp values; the scale in practice is 4/8/12/16/24/32. -->
    <dimen name="space_0_5">4dp</dimen>
    <dimen name="space_1">8dp</dimen>
    <dimen name="space_1_5">12dp</dimen>
    <dimen name="space_2">16dp</dimen>
    <dimen name="space_2_5">20dp</dimen>
    <dimen name="space_3">24dp</dimen>
    <dimen name="space_4">32dp</dimen>
    <dimen name="space_5">40dp</dimen>
    <dimen name="space_6">48dp</dimen>

    <!-- Corner radii: four tokens -->
    <!-- chips, badges, small status pills -->
    <dimen name="radius_sm">8dp</dimen>
    <!-- inputs, buttons, small icon tiles -->
    <dimen name="radius_md">12dp</dimen>
    <!-- cards and list rows -->
    <dimen name="radius_lg">16dp</dimen>
    <!-- sheets, green headers, hero cards -->
    <dimen name="radius_hero">28dp</dimen>

    <!-- Elevation: flat (0), resting card, floating sheet or bar -->
    <dimen name="elevation_card">2dp</dimen>
    <dimen name="elevation_sheet">8dp</dimen>

    <!-- Touch targets -->
    <dimen name="touch_target_min">48dp</dimen>
    <dimen name="button_height">52dp</dimen>

    <!-- Type scale: 12 / 14 / 16 / 18 / 22 / 28 / 36sp. Nothing goes below 12sp. -->
    <dimen name="text_xs">12sp</dimen>
    <dimen name="text_sm">14sp</dimen>
    <dimen name="text_md">16sp</dimen>
    <dimen name="text_lg">18sp</dimen>
    <dimen name="text_xl">22sp</dimen>
    <dimen name="text_display">28sp</dimen>
    <dimen name="text_wordmark">36sp</dimen>

    <!-- Named image heights -->
    <dimen name="image_height_detail">300dp</dimen>
    <dimen name="image_height_card">200dp</dimen>
    <dimen name="image_height_grid">140dp</dimen>
    <dimen name="banner_height">180dp</dimen>

    <!-- Drawer dimensions -->
    <dimen name="drawer_width">280dp</dimen>
    <dimen name="drawer_header_min_height">160dp</dimen>

    <!-- Widest a single-column screen grows (cart, checkout, food detail, order detail).
         Phones are narrower than this, so it only matters on tablets: the column is centred there. -->
    <dimen name="content_max_width">600dp</dimen>
    <!-- Login and register form column on tablets -->
    <dimen name="auth_form_max_width">480dp</dimen>

    <!-- Bottom nav divider -->
    <dimen name="nav_divider_height">1dp</dimen>
</resources>
