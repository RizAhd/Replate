<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming screen: slides in from the right. Same easing and duration as slide_out_left so the two
     move as one pair with no gap showing between them. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate
        android:fromXDelta="100%p"
        android:toXDelta="0"
        android:duration="320" />
    <alpha
        android:fromAlpha="0.85"
        android:toAlpha="1.0"
        android:duration="320" />
</set>
