<?xml version="1.0" encoding="utf-8"?>
<!-- Flat on purpose: it must be pixel-identical to the system splash background, so the hand-over
     from the system splash to this screen has no visible jump. The glow is a separate view that fades in. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/splash_bg" />
</shape>
