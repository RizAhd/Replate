<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent pill for tappable actions on the green headers. The 4dp insets keep the visible pill
     40dp tall while the view itself is 48dp, so the touch target stays comfortable. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item android:id="@android:id/mask">
        <inset
            android:insetBottom="4dp"
            android:insetTop="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#000000" />
                <corners android:radius="@dimen/radius_sm" />
            </shape>
        </inset>
    </item>
    <item>
        <inset
            android:insetBottom="4dp"
            android:insetTop="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#1AFFFFFF" />
                <corners android:radius="@dimen/radius_sm" />
            </shape>
        </inset>
    </item>
</ripple>
