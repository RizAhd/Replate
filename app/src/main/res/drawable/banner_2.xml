<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E8521A"
                android:centerColor="#F97316"
                android:endColor="#FDBA74" />
        </shape>
    </item>

    <item android:gravity="start|bottom" android:left="-24dp" android:bottom="-20dp">
        <shape android:shape="oval">
            <size android:width="170dp" android:height="170dp" />
            <solid android:color="#20FFFFFF" />
        </shape>
    </item>

    <item android:gravity="end|top" android:right="-20dp" android:top="-14dp">
        <shape android:shape="oval">
            <size android:width="110dp" android:height="110dp" />
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
