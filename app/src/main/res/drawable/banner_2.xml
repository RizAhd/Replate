<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E8521A"
                android:centerColor="#F97316"
                android:endColor="#FDBA74" />
        </shape>
    </item>

    <item android:gravity="start|bottom" android:left="-22dp" android:bottom="-16dp">
        <shape android:shape="oval">
            <size android:width="170dp" android:height="170dp" />
            <solid android:color="#22FFFFFF" />
        </shape>
    </item>

    <item android:gravity="end|center_vertical" android:right="14dp">
        <bitmap
            android:src="@drawable/ic_onboarding_discover"
            android:tint="#F2FFFFFF"
            android:gravity="center" />
    </item>
</layer-list>
