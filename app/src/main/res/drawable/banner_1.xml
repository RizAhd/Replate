<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A6B3C"
                android:centerColor="#25A55A"
                android:endColor="#4FCB7D" />
        </shape>
    </item>

    <item android:gravity="end|bottom" android:right="-20dp" android:bottom="-12dp">
        <shape android:shape="oval">
            <size android:width="160dp" android:height="160dp" />
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>

    <item android:gravity="end|top" android:right="14dp" android:top="16dp">
        <bitmap
            android:src="@drawable/ic_onboarding_save"
            android:tint="#F2FFFFFF"
            android:gravity="center" />
    </item>
</layer-list>
