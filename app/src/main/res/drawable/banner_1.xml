<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A6B3C"
                android:centerColor="#25A55A"
                android:endColor="#4FCB7D" />
        </shape>
    </item>

    <item android:gravity="end|bottom" android:right="-24dp" android:bottom="-24dp">
        <shape android:shape="oval">
            <size android:width="180dp" android:height="180dp" />
            <solid android:color="#22FFFFFF" />
        </shape>
    </item>

    <item android:gravity="start|top" android:left="-18dp" android:top="-18dp">
        <shape android:shape="oval">
            <size android:width="120dp" android:height="120dp" />
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
