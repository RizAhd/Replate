<?xml version="1.0" encoding="utf-8"?>
<!-- Empty feed on Home: the shared empty-state look (128dp pale circle, 56dp glyph) as one drawable,
     so it can sit above the message as the TextView's top drawable -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/leaf_pale" />
            <size
                android:width="128dp"
                android:height="128dp" />
        </shape>
    </item>
    <item
        android:width="56dp"
        android:height="56dp"
        android:drawable="@drawable/ic_no_meals"
        android:gravity="center" />
</layer-list>
