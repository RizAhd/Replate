<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#134E4A"
                android:centerColor="#0F766E"
                android:endColor="#2DD4BF" />
        </shape>
    </item>

    <item android:gravity="end|bottom" android:right="-16dp" android:bottom="-24dp">
        <shape android:shape="oval">
            <size android:width="160dp" android:height="160dp" />
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>

    <item android:gravity="start|top" android:left="-16dp" android:top="-16dp">
        <shape android:shape="oval">
            <size android:width="96dp" android:height="96dp" />
            <solid android:color="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
