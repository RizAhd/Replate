<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#134E4A"
                android:centerColor="#0F766E"
                android:endColor="#2DD4BF" />
        </shape>
    </item>

    <item android:gravity="end|bottom" android:right="-14dp" android:bottom="-20dp">
        <shape android:shape="oval">
            <size android:width="150dp" android:height="150dp" />
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>

    <item
        android:left="14dp"
        android:top="16dp"
        android:width="56dp"
        android:height="56dp"
        android:gravity="start|top"
        android:drawable="@drawable/ic_onboarding_nearby" />
</layer-list>
