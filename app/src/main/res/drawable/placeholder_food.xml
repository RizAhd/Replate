<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while a food photo loads or when it fails: pale leaf fill with one quiet restaurant glyph.
     The fill has a 3:2 size so image views that crop (centerCrop) keep the glyph near 40dp on a
     full-width card and smaller on thumbnails, instead of blowing it up to the view size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/leaf_pale" />
            <size
                android:width="360dp"
                android:height="240dp" />
        </shape>
    </item>
    <item
        android:width="40dp"
        android:height="40dp"
        android:drawable="@drawable/ic_placeholder_restaurant"
        android:gravity="center" />
</layer-list>
