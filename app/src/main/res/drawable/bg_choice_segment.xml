<?xml version="1.0" encoding="utf-8"?>
<!-- Pickup / delivery toggle: filled green when selected, outlined when not -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <stroke android:width="1dp" android:color="@color/primary" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_white" />
            <stroke android:width="1dp" android:color="@color/md_theme_outlineVariant" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</selector>
