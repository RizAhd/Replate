<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_2"
    android:layout_marginVertical="@dimen/space_1"
    style="@style/Widget.REPLATE.Card.Row">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/image_height_card">

            <ImageView
                android:id="@+id/ivFoodImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_food_image"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_food" />

            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_scrim_bottom" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_1_5">

                <TextView
                    android:id="@+id/tvDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_discount"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="@dimen/space_0_5"
                    tools:text="@string/food_discount_placeholder"
                    android:textColor="@color/white"
                    android:textAppearance="@style/TextAppearance.REPLATE.Caption"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_distance"
                    app:drawableStartCompat="@drawable/ic_location_small"
                    android:drawablePadding="4dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="@dimen/space_0_5"
                    tools:text="@string/food_distance_placeholder"
                    android:textColor="@color/white"
                    android:textAppearance="@style/TextAppearance.REPLATE.Caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStockLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/space_1_5"
                android:background="@drawable/badge_urgency"
                android:paddingHorizontal="10dp"
                android:paddingVertical="@dimen/space_0_5"
                android:textAppearance="@style/TextAppearance.REPLATE.Caption"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Only 2 left" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_1_5"
            android:paddingTop="@dimen/space_1_5"
            android:paddingEnd="@dimen/space_1_5"
            android:paddingBottom="@dimen/space_1_5">

            <TextView
                android:id="@+id/tvFoodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                tools:text="@string/food_name_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_md" />

            <TextView
                android:id="@+id/tvHotelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:maxLines="1"
                tools:text="@string/food_hotel_placeholder"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />

            <TextView
                android:id="@+id/tvPickupTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs"
                tools:text="Pickup: 18:00 - 20:00" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1_5"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOriginalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="@string/price_original_placeholder"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/text_xs"
                        android:fontFamily="@font/poppins_regular" />

                    <TextView
                        android:id="@+id/tvDiscountedPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="@string/price_discounted_placeholder"
                        android:textColor="@color/green_primary"
                        android:textSize="@dimen/text_lg"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ivAddToCart"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/food_card_add"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_sm_compact"
                    android:textStyle="bold"
                    app:backgroundTint="@color/green_primary"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_add_white"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
