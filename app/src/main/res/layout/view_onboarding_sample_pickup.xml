<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding slide 2: where and until when to collect, as the app shows it (an example) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:contentDescription="@string/onboarding_sample_pickup_cd"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/elevation_sheet"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/space_1_5"
        android:paddingStart="@dimen/space_1_5"
        android:paddingEnd="@dimen/space_2_5">

        <FrameLayout
            android:layout_width="@dimen/space_5"
            android:layout_height="@dimen/space_5"
            android:background="@drawable/circle_primary_light">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_location"
                app:tint="@color/leaf" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1_5"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/onboarding_sample_place"
                android:textAppearance="@style/TextAppearance.REPLATE.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_sample_pickup_until"
                android:textAppearance="@style/TextAppearance.REPLATE.Caption" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
