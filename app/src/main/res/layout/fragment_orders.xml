<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:orientation="vertical">

    <!-- Header -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_2"
        style="@style/Widget.REPLATE.Card.Header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_2_5">

            <TextView
                style="@style/Widget.REPLATE.Header.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/orders_my_orders" />

            <TextView
                style="@style/Widget.REPLATE.Header.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/orders_track_active_pickups_completed_orders" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tab Layout for Order Status -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_2"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="@dimen/elevation_card">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:fontFamily="@font/poppins_medium"
            app:tabIndicatorColor="@color/primary"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/primary"
            app:tabTextColor="@color/text_secondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/orders_active" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/orders_completed" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/orders_cancelled" />

        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Loading: sits under the tabs, above the list -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressBar"
        android:layout_gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:layout_width="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/green_primary" />

    <!-- Refreshing failed but saved orders are still listed -->
    <include
        android:id="@+id/errorBanner"
        layout="@layout/view_error_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Orders list; pull down to refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrders"
            android:layoutAnimation="@anim/layout_animation_slide_from_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="never"
            android:paddingTop="@dimen/space_1_5"
            android:paddingBottom="@dimen/space_1" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Nothing saved and loading failed -->
    <include
        android:id="@+id/errorState"
        layout="@layout/view_error_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_3"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.REPLATE.EmptyState.Circle">

            <ImageView
                style="@style/Widget.REPLATE.EmptyState.Icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_empty_orders" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/orders_no_orders_yet"
            android:textAppearance="@style/TextAppearance.REPLATE.Headline"
            android:textColor="@color/text_primary" />

        <TextView
            style="@style/Widget.REPLATE.EmptyState.Body"
            android:text="@string/orders_when_you_reserve_a_rescue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowse"
            style="@style/Widget.REPLATE.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_3"
            android:minWidth="160dp"
            android:paddingHorizontal="@dimen/space_4"
            android:text="@string/orders_browse_deals" />

    </LinearLayout>

</LinearLayout>
