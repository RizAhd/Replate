<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_filters_title"
            android:textAppearance="@style/TextAppearance.REPLATE.Headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0_5"
            android:text="@string/search_filters_subtitle"
            android:textAppearance="@style/TextAppearance.REPLATE.Body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/search_filters_sort"
            android:textAppearance="@style/TextAppearance.REPLATE.Label" />

        <RadioGroup
            android:id="@+id/rgSort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/rbForYou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_filter_for_you" />

            <RadioButton
                android:id="@+id/rbNearby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_filter_nearby" />

            <RadioButton
                android:id="@+id/rbPriceLow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_filter_low_price" />

            <RadioButton
                android:id="@+id/rbPriceHigh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_filter_high_price" />

            <RadioButton
                android:id="@+id/rbDiscount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_filter_discount" />

            <RadioButton
                android:id="@+id/rbRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_filter_rating" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/search_filters_category"
            android:textAppearance="@style/TextAppearance.REPLATE.Label" />

        <Spinner
            android:id="@+id/spCategory"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/button_outline_neutral"
            android:paddingHorizontal="10dp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbAvailableOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/search_filter_available_only"
            app:buttonTint="@color/green_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetFilters"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:text="@string/search_filters_reset"
                android:textAllCaps="false"
                app:icon="@drawable/ic_back"
                app:iconTint="@color/green_primary"
                app:strokeColor="@color/green_primary"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyFilters"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="@color/green_primary"
                android:text="@string/search_filters_apply"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>

