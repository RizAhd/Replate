<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_2"
            style="@style/Widget.REPLATE.Card.Header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_2_5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Only shown when Search is opened as its own screen, not as a tab -->
                    <ImageView
                        android:id="@+id/ivSearchBack"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_marginStart="-12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_back"
                        android:padding="@dimen/space_1_5"
                        android:src="@drawable/ic_back"
                        android:visibility="gone"
                        app:tint="@color/white" />

                    <TextView
                        style="@style/Widget.REPLATE.Header.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/search_title" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardFilterAction"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        app:cardBackgroundColor="@color/overlay_white_15"
                        app:cardCornerRadius="@dimen/radius_md"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/ivFilter"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/search_filter_action"
                            android:src="@drawable/ic_filter"
                            app:tint="@color/white" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.REPLATE.Card.Search"
                    android:layout_marginTop="@dimen/space_1_5">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/space_2">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_search"
                            app:tint="@color/text_secondary" />

                        <EditText
                            android:id="@+id/etSearch"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_1_5"
                            android:autofillHints=""
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/poppins_regular"
                            android:hint="@string/search_hint_full"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/space_1"
                    android:paddingBottom="@dimen/space_1">

                    <TextView
                        android:id="@+id/tvActiveFilter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/badge_outline_white"
                        android:minHeight="@dimen/touch_target_min"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_medium"
                        android:paddingHorizontal="@dimen/space_1_5"
                        android:paddingVertical="@dimen/space_0_5"
                        tools:text="@string/search_active_filter_default"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_xs" />

                    <TextView
                        android:id="@+id/tvFilterHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_1_5"
                        android:text="@string/search_filter_hint"
                        android:textColor="@color/white_85"
                        android:textSize="@dimen/text_xs" />
                </LinearLayout>

        
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent Searches Section -->
        <LinearLayout
            android:id="@+id/recentSearchesSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_2"
            android:paddingTop="@dimen/space_1_5"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivRecentIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_time"
                    app:tint="@color/text_secondary"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvRecentTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_1"
                    android:text="@string/search_recent_title"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/tvClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search_recent_clear"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/green_primary"
                    android:textSize="@dimen/text_xs"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="@dimen/touch_target_min"
                    android:paddingHorizontal="@dimen/space_1" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRecentSearches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvResultsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_2"
            android:layout_marginTop="@dimen/space_1_5"
            android:layout_marginBottom="@dimen/space_1"
            android:background="@drawable/badge_status_active"
            android:paddingHorizontal="@dimen/space_1_5"
            android:paddingVertical="@dimen/space_0_5"
            tools:text="@string/search_results_default"
            android:textAppearance="@style/TextAppearance.REPLATE.Caption"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/green_primary" />

        <!-- Refreshing failed but saved dishes are still searchable -->
        <include
            android:id="@+id/errorBanner"
            layout="@layout/view_error_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="never"
            android:paddingStart="@dimen/space_1"
            android:paddingTop="@dimen/space_0_5"
            android:paddingEnd="@dimen/space_1"
            android:paddingBottom="@dimen/space_1" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_3"
            android:visibility="gone">

            <!-- Shared empty-state look: 128dp pale circle, 56dp decorative icon, title, body, optional action -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.REPLATE.EmptyState.Circle">

                <ImageView
                    style="@style/Widget.REPLATE.EmptyState.Icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search_empty"
                    app:tint="@color/green_primary" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.REPLATE.EmptyState.Title"
                android:text="@string/search_empty_title" />

            <TextView
                style="@style/Widget.REPLATE.EmptyState.Body"
                android:text="@string/search_empty_suggestion" />

            <!-- Only shown when a search text or filter is active -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearFilters"
                style="@style/Widget.REPLATE.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/search_clear_filters"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Nothing saved and loading failed -->
        <include
            android:id="@+id/errorState"
            layout="@layout/view_error_state"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/loadingOverlaySearch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim_white_40"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/white"
            android:paddingHorizontal="@dimen/space_2_5"
            android:paddingVertical="@dimen/space_2"
            android:elevation="@dimen/elevation_sheet">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressBar"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/green_primary" />

            <TextView
                android:id="@+id/tvLoadingSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/search_loading_fresh"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
