<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_2_5"
            android:paddingEnd="@dimen/space_2"
            android:paddingBottom="@dimen/space_1_5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_title"
                    android:textAppearance="@style/TextAppearance.REPLATE.Headline"
                    android:textColor="@color/white" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFilterAction"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardBackgroundColor="#26FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivFilter"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/search_filter_action"
                        android:src="@drawable/ic_filter"
                        app:tint="@color/white" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1_5"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/cd_arrow_right"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_secondary" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_1_5"
                        android:autofillHints=""
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/poppins_regular"
                        android:hint="@string/search_hint_full"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="@dimen/text_sm" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_1"
                android:paddingBottom="@dimen/space_1">

                <TextView
                    android:id="@+id/tvActiveFilter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/badge_outline_white"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingHorizontal="@dimen/space_1_5"
                    android:paddingVertical="@dimen/space_0_5"
                    android:text="@string/search_active_filter_default"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/tvFilterHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_1_5"
                    android:text="@string/search_filter_hint"
                    android:textColor="@color/white_70"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

        </LinearLayout>

        <!-- Recent Searches Section -->
        <LinearLayout
            android:id="@+id/recentSearchesSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_2"
            android:paddingTop="@dimen/space_1_5"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_time"
                    app:tint="@color/text_secondary"
                    android:contentDescription="@string/cd_arrow_right" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/search_recent_title"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/tvClearHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search_recent_clear"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/green_primary"
                    android:textSize="@dimen/text_caption"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRecentSearches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvResultsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_2"
            android:layout_marginTop="@dimen/space_1_5"
            android:layout_marginBottom="@dimen/space_1"
            android:background="@drawable/badge_status_active"
            android:paddingHorizontal="@dimen/space_1_5"
            android:paddingVertical="@dimen/space_0_5"
            android:text="@string/search_results_default"
            android:textAppearance="@style/TextAppearance.REPLATE.Caption"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/green_primary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="never"
            android:paddingStart="@dimen/space_1"
            android:paddingTop="@dimen/space_0_5"
            android:paddingEnd="@dimen/space_1"
            android:paddingBottom="@dimen/space_1" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_3"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="128dp"
                android:layout_height="128dp"
                app:cardBackgroundColor="@color/green_pale"
                app:cardCornerRadius="@dimen/radius_hero"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_search"
                    android:src="@drawable/ic_search_empty"
                    app:tint="@color/green_primary" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:gravity="center"
                android:text="@string/search_empty_title"
                android:textAppearance="@style/TextAppearance.REPLATE.Headline"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center"
                android:text="@string/search_empty_suggestion"
                android:textAppearance="@style/TextAppearance.REPLATE.Body" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/loadingOverlaySearch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/white"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:elevation="6dp">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/green_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLoadingSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/search_loading_fresh"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
