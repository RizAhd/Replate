<?xml version="1.0" encoding="utf-8"?>
<!-- Takes the place of a list that could not load: what went wrong and a Try again button.
     Included with an id; ErrorStates.show() / hide() fill and toggle it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_3">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.REPLATE.EmptyState.Circle"
        app:cardBackgroundColor="@color/md_theme_surfaceContainer">

        <ImageView
            style="@style/Widget.REPLATE.EmptyState.Icon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_cloud_off"
            app:tint="@color/text_secondary" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvErrorMessage"
        style="@style/Widget.REPLATE.EmptyState.Body"
        android:layout_marginTop="@dimen/space_3"
        android:accessibilityLiveRegion="polite" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnErrorRetry"
        style="@style/Widget.REPLATE.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/action_retry" />
</LinearLayout>
