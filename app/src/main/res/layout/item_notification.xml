<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/surface_white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/md_theme_outlineVariant"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left accent strip (color changes per category via code) -->
        <View
            android:id="@+id/viewAccentStrip"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/green_primary"
            android:minHeight="80dp" />

        <!-- Content row -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="14dp"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <!-- Icon with unread badge overlay -->
            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/ivIcon"
                    android:importantForAccessibility="no"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/circle_primary_light"
                    android:padding="11dp"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/green_primary" />

                <!-- Unread dot badge (top-right corner of icon) -->
                <View
                    android:id="@+id/unreadDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/circle_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Notification Title"
                    android:textAppearance="@style/TextAppearance.REPLATE.Label"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/tvBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Notification body text"
                    android:textAppearance="@style/TextAppearance.REPLATE.Body"
                    android:textSize="@dimen/text_sm_compact"
                    android:lineSpacingMultiplier="1.2" />

                <!-- Category chip + Time row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCategoryChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_category_chip"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/notification_order"
                        android:textColor="@color/green_primary"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="2 hours ago"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- Delete button -->
            <ImageView
                android:id="@+id/ivDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notification_delete_notification_cd"
                android:padding="7dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_hint" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
