<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_2"
    android:layout_marginVertical="@dimen/space_0_5"
    style="@style/Widget.REPLATE.Card.Row">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left accent strip (color changes per category via code) -->
        <View
            android:id="@+id/viewAccentStrip"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/green_primary"
            android:minHeight="80dp" />

        <!-- Content row -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_2"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_1_5">

            <!-- Icon with unread badge overlay -->
            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="@dimen/space_1_5">

                <ImageView
                    android:id="@+id/ivIcon"
                    android:importantForAccessibility="no"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/circle_primary_light"
                    android:padding="@dimen/space_1_5"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/green_primary" />

                <!-- Unread dot badge (top-right corner of icon) -->
                <View
                    android:id="@+id/unreadDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/circle_primary"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Notification Title"
                    android:textAppearance="@style/TextAppearance.REPLATE.Label" />

                <TextView
                    android:id="@+id/tvBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:ellipsize="end"
                    android:maxLines="2"
                    tools:text="Notification body text"
                    android:textAppearance="@style/TextAppearance.REPLATE.Body"
                    android:lineSpacingMultiplier="1.2" />

                <!-- Category chip + Time row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCategoryChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_category_chip"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/notification_order"
                        android:textColor="@color/green_primary"
                        android:textSize="@dimen/text_xs"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_0_5"
                        android:fontFamily="@font/poppins_regular"
                        tools:text="2 hours ago"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/text_xs" />
                </LinearLayout>
            </LinearLayout>

            <!-- Delete button -->
            <ImageView
                android:id="@+id/ivDelete"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notification_delete_notification_cd"
                android:padding="@dimen/space_2"
                android:src="@drawable/ic_close"
                app:tint="@color/text_hint" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
