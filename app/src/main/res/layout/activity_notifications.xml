<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:orientation="vertical">

    <!-- ─── Premium Header Card ─── -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/green_primary"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Top row: Back · Title + Badge -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_back"
                    android:padding="4dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notifications_title"
                        android:textAppearance="@style/TextAppearance.REPLATE.Subheading"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tvUnreadCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/circle_primary_light"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:minWidth="24dp"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="3dp"
                        android:text="0"
                        android:textColor="@color/green_primary"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Action buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDeleteAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_outline_white"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="@dimen/space_1_5"
                    android:paddingVertical="@dimen/space_1"
                    android:text="@string/notifications_delete_all"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_xs" />

                <TextView
                    android:id="@+id/tvMarkAllRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_outline_white"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="@dimen/space_1_5"
                    android:paddingVertical="@dimen/space_1"
                    android:text="@string/notifications_mark_all_read"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_xs" />
            </LinearLayout>

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/notifications_header_subtitle"
                android:textAppearance="@style/TextAppearance.REPLATE.Body"
                android:textColor="@color/text_on_primary_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ─── Filter Chips Row ─── -->
    <HorizontalScrollView
        android:id="@+id/chipScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:scrollbars="none"
        android:clipToPadding="false">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:checked="true"
                android:fontFamily="@font/poppins_medium"
                android:textSize="12sp"
                app:chipBackgroundColor="@color/green_pale"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/green_primary"
                app:chipStrokeWidth="0.5dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOrders"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Orders"
                android:fontFamily="@font/poppins_medium"
                android:textSize="12sp"
                app:chipIcon="@drawable/ic_orders"
                app:chipIconSize="16dp"
                app:chipIconTint="@color/green_primary"
                app:chipBackgroundColor="@color/surface_white"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/md_theme_outlineVariant"
                app:chipStrokeWidth="0.5dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDeals"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deals"
                android:fontFamily="@font/poppins_medium"
                android:textSize="12sp"
                app:chipIcon="@drawable/ic_deal"
                app:chipIconSize="16dp"
                app:chipIconTint="@color/orange_accent"
                app:chipBackgroundColor="@color/surface_white"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/md_theme_outlineVariant"
                app:chipStrokeWidth="0.5dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPickup"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pickup"
                android:fontFamily="@font/poppins_medium"
                android:textSize="12sp"
                app:chipIcon="@drawable/ic_pickup"
                app:chipIconSize="16dp"
                app:chipIconTint="@color/badge_distance"
                app:chipBackgroundColor="@color/surface_white"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/md_theme_outlineVariant"
                app:chipStrokeWidth="0.5dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAdmin"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System"
                android:fontFamily="@font/poppins_medium"
                android:textSize="12sp"
                app:chipIcon="@drawable/ic_admin_announce"
                app:chipIconSize="16dp"
                app:chipIconTint="@color/primary_dark"
                app:chipBackgroundColor="@color/surface_white"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/md_theme_outlineVariant"
                app:chipStrokeWidth="0.5dp" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- ─── Loading Indicator ─── -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:indeterminateTint="@color/green_primary"
        android:visibility="gone" />

    <!-- ─── Pull-to-Refresh + RecyclerView ─── -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ─── Enhanced Empty State ─── -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="36dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="110dp"
            android:layout_height="110dp"
            app:cardBackgroundColor="@color/green_pale"
            app:cardCornerRadius="55dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_notifications_empty"
                android:src="@drawable/ic_notification"
                app:tint="@color/green_primary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/notifications_empty_title"
            android:textAppearance="@style/TextAppearance.REPLATE.Headline"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:text="@string/notifications_empty_subtitle"
            android:textAppearance="@style/TextAppearance.REPLATE.Body"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowseDeals"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Browse Deals"
            android:textColor="@color/green_primary"
            app:cornerRadius="12dp"
            app:strokeColor="@color/green_primary"
            app:strokeWidth="1dp" />
    </LinearLayout>

</LinearLayout>
