<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:orientation="vertical">

    <!-- ─── Premium Header Card ─── -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_2"
        style="@style/Widget.REPLATE.Card.Header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_2_5">

            <!-- Top row: Back · Title + Badge -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivBack"
                    style="@style/Widget.REPLATE.Header.Back"
                    android:contentDescription="@string/cd_back"
                    android:layout_centerVertical="true" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.REPLATE.Header.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notifications_title" />

                    <TextView
                        android:id="@+id/tvUnreadCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_1"
                        android:background="@drawable/circle_primary_light"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:minWidth="24dp"
                        android:paddingHorizontal="@dimen/space_1"
                        android:paddingVertical="@dimen/space_0_5"
                        tools:text="0"
                        android:textColor="@color/green_primary"
                        android:textSize="@dimen/text_xs"
                        android:visibility="gone" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Action buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1_5"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDeleteAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_outline_white"
                    android:minHeight="@dimen/touch_target_min"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="@dimen/space_1_5"
                    android:paddingVertical="@dimen/space_1"
                    android:text="@string/notifications_delete_all"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_xs" />

                <TextView
                    android:id="@+id/tvMarkAllRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_1"
                    android:background="@drawable/badge_outline_white"
                    android:minHeight="@dimen/touch_target_min"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="@dimen/space_1_5"
                    android:paddingVertical="@dimen/space_1"
                    android:text="@string/notifications_mark_all_read"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_xs" />
            </LinearLayout>

            <!-- Subtitle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1_5"
                android:text="@string/notifications_header_subtitle"
                android:textAppearance="@style/TextAppearance.REPLATE.Body"
                android:textColor="@color/text_on_primary_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ─── Filter Chips Row ─── -->
    <HorizontalScrollView
        android:id="@+id/chipScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_2"
        android:scrollbars="none"
        android:clipToPadding="false">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notifications_all"
                android:checked="true"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/text_xs"
                app:chipBackgroundColor="@color/chip_choice_background"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/chip_choice_stroke"
                app:chipStrokeWidth="0.5dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOrders"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notifications_orders"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/text_xs"
                app:chipIcon="@drawable/ic_orders"
                app:chipIconSize="16dp"
                app:chipIconTint="@color/green_primary"
                app:chipBackgroundColor="@color/chip_choice_background"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/chip_choice_stroke"
                app:chipStrokeWidth="0.5dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDeals"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notifications_deals"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/text_xs"
                app:chipIcon="@drawable/ic_deal"
                app:chipIconSize="16dp"
                app:chipIconTint="@color/orange_accent"
                app:chipBackgroundColor="@color/chip_choice_background"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/chip_choice_stroke"
                app:chipStrokeWidth="0.5dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPickup"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notifications_pickup"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/text_xs"
                app:chipIcon="@drawable/ic_pickup"
                app:chipIconSize="16dp"
                app:chipIconTint="@color/badge_distance"
                app:chipBackgroundColor="@color/chip_choice_background"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/chip_choice_stroke"
                app:chipStrokeWidth="0.5dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAdmin"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notifications_system"
                android:fontFamily="@font/poppins_medium"
                android:textSize="@dimen/text_xs"
                app:chipIcon="@drawable/ic_admin_announce"
                app:chipIconSize="16dp"
                app:chipIconTint="@color/primary_dark"
                app:chipBackgroundColor="@color/chip_choice_background"
                app:checkedIconVisible="false"
                app:chipStrokeColor="@color/chip_choice_stroke"
                app:chipStrokeWidth="0.5dp" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- ─── Loading Indicator ─── -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_1"
        android:indeterminateTint="@color/green_primary"
        android:visibility="gone" />

    <!-- ─── Pull-to-Refresh + RecyclerView ─── -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_1"
            android:paddingBottom="@dimen/space_1" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ─── Enhanced Empty State ─── -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_3"
        android:visibility="gone">

        <!-- Shared empty-state look: 128dp pale circle, 56dp decorative icon, title, body, optional action -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="128dp"
            android:layout_height="128dp"
            app:cardBackgroundColor="@color/green_pale"
            app:cardCornerRadius="64dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_notification"
                app:tint="@color/green_primary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center"
            android:text="@string/notifications_empty_title"
            android:textAppearance="@style/TextAppearance.REPLATE.Headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center"
            android:text="@string/notifications_empty_subtitle"
            android:textAppearance="@style/TextAppearance.REPLATE.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowseDeals"
            style="@style/Widget.REPLATE.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_3"
            android:minWidth="160dp"
            android:paddingHorizontal="@dimen/space_4"
            android:text="@string/notifications_browse_deals" />
    </LinearLayout>

</LinearLayout>
