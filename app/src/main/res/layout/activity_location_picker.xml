<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Back button and search share one row so this screen has the same way out as every other -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/space_2"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnLocationBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="@dimen/elevation_card_raised">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/searchCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="@dimen/elevation_card_raised"
            app:cardBackgroundColor="@color/surface_white">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:queryHint="@string/location_picker_search_hint" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUseLiveLocation"
        style="@style/Widget.REPLATE.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        android:layout_below="@id/topBar"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/space_1"
        android:layout_marginEnd="@dimen/space_2"
        android:minHeight="0dp"
        android:text="@string/location_picker_use_live"
        android:textSize="@dimen/text_xs"
        app:icon="@drawable/ic_my_location"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_0_5"
        app:cornerRadius="@dimen/radius_md" />

    <ImageView
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_centerInParent="true"
        android:layout_marginBottom="@dimen/touch_target_min"
        android:src="@drawable/ic_location_pin"
        android:contentDescription="@string/cd_location_icon" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="@dimen/space_2"
        app:cardBackgroundColor="@color/surface_white"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="@dimen/elevation_sheet">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_2_5">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location_picker_title"
                android:textAppearance="@style/TextAppearance.REPLATE.Subheading" />

            <TextView
                android:id="@+id/tvSelectedAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="@string/location_picker_move_hint"
                android:textAppearance="@style/TextAppearance.REPLATE.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmLocation"
                style="@style/Widget.REPLATE.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/location_picker_confirm" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
