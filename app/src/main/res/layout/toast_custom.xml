<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/space_2"
    android:paddingEnd="@dimen/space_2"
    android:paddingTop="@dimen/space_1_5"
    android:paddingBottom="@dimen/space_1_5"
    android:background="@drawable/bg_toast_custom"
    android:elevation="@dimen/elevation_card">

    <ImageView
        android:id="@+id/ivToastIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="@dimen/space_1_5"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/tvToastMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:maxLines="2"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_sm" />

</LinearLayout>
