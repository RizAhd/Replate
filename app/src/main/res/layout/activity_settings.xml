<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_2"
        style="@style/Widget.REPLATE.Card.Header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_2_5">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivBack"
                    style="@style/Widget.REPLATE.Header.Back"
                    android:layout_centerVertical="true" />

                <TextView
                    style="@style/Widget.REPLATE.Header.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/settings_title" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2_5"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:contentDescription="@string/cd_profile_photo"
                    android:src="@drawable/ic_profile_placeholder"
                    app:civ_border_color="@color/white"
                    app:civ_border_width="3dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangePhoto"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_1_5"
                    android:text="@string/settings_change_photo"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_semibold"
                    app:strokeColor="@color/white_70"
                    app:cornerRadius="@dimen/radius_md" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingBottom="@dimen/space_2">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_2">

                    <TextView
                        style="@style/Widget.REPLATE.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_profile_info" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        style="@style/Widget.REPLATE.TextInputLayout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:inputType="textPersonName|textCapWords"
                            android:imeOptions="actionNext"
                            android:autofillHints="name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/settings_hint_full_name" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        style="@style/Widget.REPLATE.TextInputLayout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            android:imeOptions="actionNext"
                            android:autofillHints="phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/settings_hint_phone"
                            android:inputType="phone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        style="@style/Widget.REPLATE.TextInputLayout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionNext"
                            android:autofillHints="emailAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:hint="@string/settings_hint_email" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        style="@style/Widget.REPLATE.TextInputLayout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAddress"
                            android:imeOptions="actionDone"
                            android:autofillHints="postalAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/settings_hint_pickup_address"
                            android:inputType="textPostalAddress" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickAddress"
                        style="@style/Widget.REPLATE.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_gravity="end"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="@string/settings_pick_from_map"
                        android:textSize="@dimen/text_xs"
                        app:icon="@drawable/ic_location_pin"
                        app:iconTint="@color/ember" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveProfile"
                        style="@style/Widget.REPLATE.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/settings_save_changes" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_2">

                    <TextView
                        style="@style/Widget.REPLATE.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_preferences" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifications"
                        style="@style/Widget.REPLATE.SettingsSwitch"
                        android:layout_marginTop="@dimen/space_1"
                        android:checked="true"
                        android:text="@string/settings_push_notifications" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchLocation"
                        style="@style/Widget.REPLATE.SettingsSwitch"
                        android:checked="true"
                        android:text="@string/settings_location_services" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/settings_notify_about"
                        android:textAppearance="@style/TextAppearance.REPLATE.Caption" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifyOrders"
                        style="@style/Widget.REPLATE.SettingsSwitch"
                        android:layout_marginTop="@dimen/space_1"
                        android:checked="true"
                        android:text="@string/settings_notify_orders" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifyDeals"
                        style="@style/Widget.REPLATE.SettingsSwitch"
                        android:checked="true"
                        android:text="@string/settings_notify_deals" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifyPickup"
                        style="@style/Widget.REPLATE.SettingsSwitch"
                        android:checked="true"
                        android:text="@string/settings_notify_pickup" />

                    <TextView
                        android:id="@+id/rowSystemNotifications"
                        style="@style/Widget.REPLATE.SettingsRow"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="@string/settings_system_notifications" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_2">

                    <TextView
                        style="@style/Widget.REPLATE.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_data_privacy" />

                    <TextView
                        android:id="@+id/rowPrivacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:text="@string/settings_privacy_row"
                        android:textAppearance="@style/TextAppearance.REPLATE.Label" />

                    <TextView
                        android:id="@+id/rowClearCache"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp"
                        android:gravity="center_vertical"
                        android:text="@string/settings_clear_cache_row"
                        android:textAppearance="@style/TextAppearance.REPLATE.Label" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_2">

                    <TextView
                        style="@style/Widget.REPLATE.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_help_about" />

                    <TextView
                        android:id="@+id/rowHelp"
                        style="@style/Widget.REPLATE.SettingsRow"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="@string/settings_row_help" />

                    <TextView
                        android:id="@+id/rowContact"
                        style="@style/Widget.REPLATE.SettingsRow"
                        android:text="@string/settings_row_contact" />

                    <TextView
                        android:id="@+id/rowRate"
                        style="@style/Widget.REPLATE.SettingsRow"
                        android:text="@string/settings_row_rate" />

                    <TextView
                        android:id="@+id/rowShare"
                        style="@style/Widget.REPLATE.SettingsRow"
                        android:text="@string/settings_row_share" />

                    <TextView
                        android:id="@+id/rowLicenses"
                        style="@style/Widget.REPLATE.SettingsRow"
                        android:text="@string/settings_row_licenses" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_2">

                    <TextView
                        style="@style/Widget.REPLATE.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_account" />

                    <TextView
                        android:id="@+id/rowLogout"
                        style="@style/Widget.REPLATE.SettingsRow"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="@string/settings_row_logout" />

                    <TextView
                        android:id="@+id/rowDeleteAccount"
                        style="@style/Widget.REPLATE.SettingsRow"
                        android:text="@string/settings_row_delete_account"
                        android:textColor="@color/error" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/app_name"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_lg" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:text="@string/drawer_tagline"
                        android:textAppearance="@style/TextAppearance.REPLATE.Caption" />

                    <TextView
                        android:id="@+id/tvAppVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:textAppearance="@style/TextAppearance.REPLATE.Overline" />

                    <TextView
                        android:id="@+id/tvBuildAttribution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:text="@string/app_footer_built_by"
                        android:textAppearance="@style/TextAppearance.REPLATE.Caption"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
    
        </LinearLayout>
    </ScrollView>
</LinearLayout>
