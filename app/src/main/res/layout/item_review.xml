<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_1"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface_subtle"
    app:strokeColor="@color/md_theme_outlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_1_5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReviewer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                tools:text="User"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_sm" />

            <TextView
                android:id="@+id/tvReviewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                tools:text="01 Jan 2026"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVerifiedPurchase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_0_5"
            android:background="@drawable/badge_status_active"
            android:fontFamily="@font/poppins_medium"
            android:paddingHorizontal="@dimen/space_1_5"
            android:paddingVertical="@dimen/space_0_5"
            android:text="@string/review_verified_pickup"
            android:textColor="@color/green_primary"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <RatingBar
            android:id="@+id/ratingReviewItem"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:isIndicator="true"
            android:numStars="5"
            android:stepSize="0.5"
            android:layout_marginTop="@dimen/space_0_5" />

        <TextView
            android:id="@+id/tvReviewComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:fontFamily="@font/poppins_regular"
            tools:text="Comment"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_sm" />

        <LinearLayout
            android:id="@+id/layoutReviewActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnEditReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:paddingHorizontal="@dimen/space_1_5"
                android:paddingVertical="@dimen/space_1"
                android:text="@string/review_edit"
                android:textColor="@color/green_primary"
                android:textSize="@dimen/text_sm" />

            <TextView
                android:id="@+id/btnDeleteReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:fontFamily="@font/poppins_medium"
                android:paddingHorizontal="@dimen/space_1_5"
                android:paddingVertical="@dimen/space_1"
                android:text="@string/review_delete"
                android:textColor="@color/error"
                android:textSize="@dimen/text_sm" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
