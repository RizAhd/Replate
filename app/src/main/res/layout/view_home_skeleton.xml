<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder rows shown (pulsing) while the food feed loads. Purely decorative. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginBottom="@dimen/space_1_5"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/skeleton_block" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1_5"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:background="@drawable/skeleton_block" />

            <View
                android:layout_width="140dp"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/skeleton_block" />

            <View
                android:layout_width="80dp"
                android:layout_height="14dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/skeleton_block" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginBottom="@dimen/space_1_5"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/skeleton_block" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1_5"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:background="@drawable/skeleton_block" />

            <View
                android:layout_width="120dp"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/skeleton_block" />

            <View
                android:layout_width="96dp"
                android:layout_height="14dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/skeleton_block" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/skeleton_block" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_1_5"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:background="@drawable/skeleton_block" />

            <View
                android:layout_width="150dp"
                android:layout_height="12dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/skeleton_block" />

            <View
                android:layout_width="72dp"
                android:layout_height="14dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/skeleton_block" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
