<?xml version="1.0" encoding="utf-8"?>
<!-- Sent message bubble (right side, green, WhatsApp-style) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="72dp"
    android:paddingEnd="@dimen/space_1"
    android:paddingTop="@dimen/space_0_5"
    android:paddingBottom="@dimen/space_0_5">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_bubble_sent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_2"
        android:paddingEnd="@dimen/space_2"
        android:paddingTop="@dimen/space_1"
        android:paddingBottom="@dimen/space_1"
        android:elevation="0dp">

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_sm"
            android:lineSpacingMultiplier="1.15"
            android:fontFamily="@font/poppins_regular" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_0_5"
            android:textColor="@color/white_85"
            android:textSize="@dimen/text_xs"
            android:fontFamily="@font/poppins_regular" />
    </LinearLayout>
</FrameLayout>
