<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <fragment
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_2"
        android:orientation="vertical">

        <!-- Search field and my-location button float over the map -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.REPLATE.Card.Search"
                android:layout_width="0dp"
                android:layout_weight="1"
                app:cardElevation="@dimen/elevation_card">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:iconifiedByDefault="false"
                    app:queryBackground="@android:color/transparent"
                    app:queryHint="@string/map_search_hint"
                    app:searchIcon="@drawable/ic_search" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ivMyLocation"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="@dimen/space_1"
                android:clickable="true"
                android:contentDescription="@string/cd_my_location"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="@dimen/elevation_card"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_my_location"
                    app:tint="@color/green_primary" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Persistent hint: location off or denied, hotels failed to load, or none listed yet -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMapStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="@dimen/elevation_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_2"
                android:paddingEnd="@dimen/space_1">

                <TextView
                    android:id="@+id/tvMapStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="@dimen/space_1_5"
                    android:textAppearance="@style/TextAppearance.REPLATE.Label" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMapStatusAction"
                    style="@style/Widget.REPLATE.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/space_2"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_white"
        app:cardCornerRadius="@dimen/radius_hero"
        app:cardElevation="@dimen/elevation_sheet">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_2_5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivRestaurantImage"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:background="@drawable/card_background_shape"
                    android:contentDescription="@string/cd_food_image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_food" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_1_5"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvRestaurantName"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            tools:text="Restaurant Name"
                            android:textAppearance="@style/TextAppearance.REPLATE.Subheading" />

                        <ImageView
                            android:id="@+id/ivFavoriteHotel"
                            android:layout_width="@dimen/touch_target_min"
                            android:layout_height="@dimen/touch_target_min"
                            android:layout_marginVertical="-8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/favorite_hotel_add_cd"
                            android:padding="@dimen/space_1_5"
                            android:src="@drawable/ic_favorite_border" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRestaurantAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:ellipsize="end"
                        android:maxLines="2"
                        tools:text="Address"
                        android:textAppearance="@style/TextAppearance.REPLATE.Caption" />

                    <TextView
                        android:id="@+id/tvDealsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:background="@drawable/badge_distance"
                        android:fontFamily="@font/poppins_medium"
                        android:paddingHorizontal="@dimen/space_1_5"
                        android:paddingVertical="@dimen/space_0_5"
                        tools:text="5 deals available"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_xs" />

                    <TextView
                        android:id="@+id/tvRouteInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:fontFamily="@font/poppins_medium"
                        android:text="@string/map_tap_marker_route"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_xs" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1_5"
                android:text="@string/map_available_now"
                android:textAppearance="@style/TextAppearance.REPLATE.Label" />

            <TextView
                android:id="@+id/tvAvailableItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_0_5"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="@string/map_loading_items"
                android:textAppearance="@style/TextAppearance.REPLATE.Body"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewDeals"
                    style="@style/Widget.REPLATE.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginEnd="@dimen/space_1"
                    android:layout_weight="1"
                    android:text="@string/map_view_deals_button" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowRoute"
                    style="@style/Widget.REPLATE.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginStart="@dimen/space_1"
                    android:layout_weight="1"
                    android:text="@string/map_route_button" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <!-- Small white disc so the spinner is visible over any map colour; the map stays usable around it -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="@dimen/radius_hero"
            app:cardElevation="@dimen/elevation_card">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_gravity="center"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/green_primary"
                app:indicatorSize="24dp" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
