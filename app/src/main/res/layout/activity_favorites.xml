<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_2"
        style="@style/Widget.REPLATE.Card.Header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_2_5">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivBack"
                    style="@style/Widget.REPLATE.Header.Back"
                    android:contentDescription="@string/cd_back"
                    android:layout_centerVertical="true" />

                <TextView
                    style="@style/Widget.REPLATE.Header.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/favorites_title" />
            </RelativeLayout>

            <TextView
                style="@style/Widget.REPLATE.Header.Subtitle"
                android:id="@+id/tvFavoritesCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                tools:text="@string/favorites_saved_count_default" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Saved dishes / saved hotels -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutFavorites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_2"
        android:background="@android:color/transparent"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/green_primary"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/green_primary"
        app:tabTextColor="@color/text_secondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/favorites_tab_dishes" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/favorites_tab_hotels" />
    </com.google.android.material.tabs.TabLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_1"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavorites"
        android:layoutAnimation="@anim/layout_animation_slide_from_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_1"
        android:paddingBottom="@dimen/space_1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavoriteHotels"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_1"
        android:paddingBottom="@dimen/space_1"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_3"
        android:visibility="gone">

        <!-- Shared empty-state look: 128dp pale circle, 56dp decorative icon, title, body, optional action -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="128dp"
            android:layout_height="128dp"
            app:cardBackgroundColor="@color/green_pale"
            app:cardCornerRadius="64dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_favorite"
                app:tint="@color/green_primary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center"
            android:text="@string/favorites_empty_title"
            android:textAppearance="@style/TextAppearance.REPLATE.Headline" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:gravity="center"
            android:text="@string/favorites_empty_subtitle"
            android:textAppearance="@style/TextAppearance.REPLATE.Body" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFindDishes"
            style="@style/Widget.REPLATE.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/favorites_empty_cta" />
    </LinearLayout>
</LinearLayout>

