<?xml version="1.0" encoding="utf-8"?>
<!-- The photo and details scroll; the Add to cart button stays pinned at the bottom. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <!-- One centred column, at most content_max_width wide: phones are narrower, so they use the full width;
         tablets get a readable column with the page background on both sides. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_3">

                <!-- Food Image with Back Button -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/image_height_detail">

                    <ImageView
                        android:id="@+id/ivFoodImage"
                        android:contentDescription="@string/cd_food_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/placeholder_food" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/gradient_scrim_bottom" />

                    <!-- Back Button -->
                    <ImageView
                        android:id="@+id/ivBack"
                        android:contentDescription="@string/cd_back"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_margin="@dimen/space_2"
                        android:background="@drawable/circle_white"
                        android:elevation="@dimen/elevation_card"
                        android:padding="@dimen/space_1_5"
                        android:src="@drawable/ic_back" />

                    <!-- Favorite Button -->
                    <ImageView
                        android:id="@+id/ivFavorite"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_gravity="bottom|end"
                        android:layout_marginBottom="@dimen/space_2"
                        android:layout_marginEnd="@dimen/space_2"
                        android:background="@drawable/circle_white"
                        android:elevation="@dimen/elevation_card"
                        android:padding="@dimen/space_1_5"
                        android:src="@drawable/ic_favorite_border"
                        android:contentDescription="@string/food_detail_add_to_favorites_cd" />

                    <!-- Discount Badge -->
                    <TextView
                        android:id="@+id/tvDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="@dimen/space_2"
                        android:background="@drawable/badge_discount"
                        android:fontFamily="@font/poppins_bold"
                        android:paddingHorizontal="@dimen/space_1_5"
                        android:paddingVertical="@dimen/space_1"
                        android:text="@string/food_detail_default_discount"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_md" />
                </FrameLayout>

                <!-- Food Details Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_2"
                    android:layout_marginTop="-24dp"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/elevation_card"
                    app:cardBackgroundColor="@color/surface_white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_2_5">

                        <!-- Food Name -->
                        <TextView
                            android:id="@+id/tvFoodName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/food_detail_default_name"
                            android:textAppearance="@style/TextAppearance.REPLATE.Headline"
                            android:textColor="@color/text_primary" />

                        <!-- Hotel Name and the heart that saves the hotel -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_0_5"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvHotelName"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/food_detail_default_hotel"
                                android:textAppearance="@style/TextAppearance.REPLATE.Body" />

                            <ImageView
                                android:id="@+id/ivFavoriteHotel"
                                android:layout_width="@dimen/touch_target_min"
                                android:layout_height="@dimen/touch_target_min"
                                android:layout_marginVertical="-8dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/favorite_hotel_add_cd"
                                android:padding="@dimen/space_1_5"
                                android:src="@drawable/ic_favorite_border" />
                        </LinearLayout>

                        <!-- Distance and Pickup Time -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1_5"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Distance Badge -->
                            <TextView
                                android:id="@+id/tvDistance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_pale"
                                android:paddingHorizontal="@dimen/space_1_5"
                                android:paddingVertical="@dimen/space_1"
                                android:text="@string/food_detail_default_distance"
                                android:textColor="@color/green_primary"
                                android:textSize="@dimen/text_xs"
                                android:textStyle="bold" />

                            <Space
                                android:layout_width="@dimen/space_1"
                                android:layout_height="1dp" />

                            <!-- Pickup Time Badge -->
                            <TextView
                                android:id="@+id/tvPickupTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/badge_pale"
                                android:paddingHorizontal="@dimen/space_1_5"
                                android:paddingVertical="@dimen/space_1"
                                android:text="@string/food_detail_default_pickup_window"
                                android:textColor="@color/ember_dark"
                                android:textSize="@dimen/text_xs"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="@dimen/space_2"
                            android:background="@color/divider" />

                        <!-- Price and Quantity Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Price Details -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvOriginalLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/food_detail_original_label"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_xs" />

                                <TextView
                                    android:id="@+id/tvOriginalPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_0_5"
                                    tools:text="LKR 800.00"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_sm" />

                                <TextView
                                    android:id="@+id/tvDiscountedPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_0_5"
                                    tools:text="LKR 500.00"
                                    android:textColor="@color/green_primary"
                                    android:textSize="@dimen/text_display"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Quantity stepper, same component as the cart rows -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageButton
                                    android:id="@+id/btnMinus"
                                    style="@style/Widget.REPLATE.StepperButton"
                                    android:contentDescription="@string/cd_decrease_quantity"
                                    android:src="@drawable/ic_remove" />

                                <TextView
                                    android:id="@+id/tvQuantity"
                                    android:layout_width="40dp"
                                    android:layout_height="wrap_content"
                                    android:accessibilityLiveRegion="polite"
                                    android:gravity="center"
                                    android:text="@string/cart_qty_default"
                                    android:textAppearance="@style/TextAppearance.REPLATE.Subheading" />

                                <ImageButton
                                    android:id="@+id/btnPlus"
                                    style="@style/Widget.REPLATE.StepperButton"
                                    android:contentDescription="@string/cd_increase_quantity"
                                    android:src="@drawable/ic_add" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Description -->
                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:lineSpacingExtra="4dp"
                            tools:text="@string/food_detail_description_placeholder"
                            android:textAppearance="@style/TextAppearance.REPLATE.Body"
                            android:textColor="@color/text_primary" />

                        <!-- Contact the hotel: three equal outlined buttons. Call and SMS use the phone
                             (telephony), Chat stays inside the app. -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/food_detail_contact_hotel"
                            android:textAppearance="@style/TextAppearance.REPLATE.Label" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCallHotel"
                                style="@style/Widget.REPLATE.Button.Contact"
                                android:contentDescription="@string/food_detail_call_hotel_cd"
                                android:text="@string/food_detail_call"
                                app:icon="@drawable/ic_phone" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSmsHotel"
                                style="@style/Widget.REPLATE.Button.Contact"
                                android:layout_marginStart="@dimen/space_1"
                                android:contentDescription="@string/food_detail_sms_hotel_cd"
                                android:text="@string/food_detail_sms"
                                app:icon="@drawable/ic_sms" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnChatHotel"
                                style="@style/Widget.REPLATE.Button.Contact"
                                android:layout_marginStart="@dimen/space_1"
                                android:contentDescription="@string/food_detail_chat_hotel_cd"
                                android:text="@string/food_detail_chat"
                                app:icon="@drawable/ic_chat_empty" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_2"
                    android:layout_marginTop="@dimen/space_1_5"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/elevation_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_2_5">

                        <TextView
                            style="@style/Widget.REPLATE.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/food_detail_user_reviews" />

                        <TextView
                            android:id="@+id/tvReviewSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_0_5"
                            tools:text="0.0 (0 reviews)"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleReviewComposer"
                            style="@style/Widget.REPLATE.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/touch_target_min"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="@string/food_detail_write_a_review" />

                        <LinearLayout
                            android:id="@+id/layoutReviewComposer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvRatingLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:labelFor="@id/ratingInput"
                                android:text="@string/food_detail_your_rating"
                                android:textAppearance="@style/TextAppearance.REPLATE.Label" />

                            <RatingBar
                                android:id="@+id/ratingInput"
                                android:contentDescription="@string/food_detail_your_rating"
                                style="?android:attr/ratingBarStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:isIndicator="false"
                                android:numStars="5"
                                android:scaleX="0.8"
                                android:scaleY="0.8"
                                android:transformPivotX="0dp"
                                android:stepSize="0.5" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etReviewComment"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/food_detail_share_your_experience_hint"
                                    android:inputType="textMultiLine"
                                    android:maxLines="3" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSubmitReview"
                                style="@style/Widget.REPLATE.Button.Primary"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_height"
                                android:layout_marginTop="@dimen/space_1"
                                android:text="@string/food_detail_submit_review"
                                app:icon="@drawable/ic_add_white"
                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                app:iconTint="@color/white" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressReviews"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/space_2"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/green_primary"
                            app:indicatorSize="24dp" />

                        <TextView
                            android:id="@+id/tvNoReviews"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1_5"
                            android:gravity="center"
                            android:text="@string/food_detail_no_reviews_yet"
                            android:textColor="@color/text_secondary"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvReviews"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_2"
                    android:layout_marginTop="@dimen/space_1_5"
                    android:layout_marginBottom="@dimen/space_2"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/elevation_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_2_5">

                        <TextView
                            style="@style/Widget.REPLATE.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/food_detail_recommended_for_you" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressRecommended"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="@dimen/space_2"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/green_primary"
                            app:indicatorSize="24dp" />

                        <TextView
                            android:id="@+id/tvNoRecommendations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_0_5"
                            android:text="@string/food_detail_no_related_products_right_now"
                            android:textColor="@color/text_secondary"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRecommended"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="0dp"
            app:cardElevation="@dimen/elevation_sheet">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToCart"
                style="@style/Widget.REPLATE.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_margin="@dimen/space_2"
                tools:text="Add to Cart - LKR 500.00" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
