<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_2"
    android:layout_marginVertical="@dimen/space_1"
    style="@style/Widget.REPLATE.Card.Row">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFavHotelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Ocean View Restaurant"
                android:textAppearance="@style/TextAppearance.REPLATE.Subheading" />

            <TextView
                android:id="@+id/tvFavHotelAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_0_5"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="12 Galle Road, Colombo"
                android:textAppearance="@style/TextAppearance.REPLATE.Caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavHotelDeals"
                style="@style/Widget.REPLATE.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/favorites_hotel_view_deals"
                android:textSize="@dimen/text_xs" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivFavHotelRemove"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/favorite_hotel_remove_cd"
            android:padding="@dimen/space_1_5"
            android:src="@drawable/ic_favorite"
            app:tint="@color/md_theme_error" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
