<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_2">

        <!-- Hero Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/green_primary"
            app:cardCornerRadius="@dimen/radius_hero"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <!-- Profile Image -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/ic_profile_placeholder"
                    app:civ_border_color="@color/white"
                    app:civ_border_width="4dp" />

                <!-- User Name -->
                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    tools:text="@string/profile_user_name_placeholder"
                    android:textAppearance="@style/TextAppearance.REPLATE.Headline"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_xl" />

                <!-- User Email -->
                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_0_5"
                    tools:text="@string/profile_user_email_placeholder"
                    android:textAppearance="@style/TextAppearance.REPLATE.Body"
                    android:textColor="@color/white_85" />

                <!-- Edit Profile Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_2"
                    android:paddingHorizontal="@dimen/space_3"
                    android:text="@string/profile_edit_profile"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_semibold"
                    app:strokeColor="@color/white_70"
                    app:cornerRadius="@dimen/radius_md" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal">

            <!-- Orders Count Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_1"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvOrdersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="@string/cart_zero"
                        android:textColor="@color/green_primary"
                        android:textAppearance="@style/TextAppearance.REPLATE.Headline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:text="@string/profile_orders"
                        android:textAppearance="@style/TextAppearance.REPLATE.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Savings Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_1"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="@dimen/radius_xl"
                app:cardElevation="@dimen/elevation_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvSavings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="@string/profile_savings_zero"
                        android:textColor="@color/ember2"
                        android:textAppearance="@style/TextAppearance.REPLATE.Headline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_0_5"
                        android:text="@string/profile_saved"
                        android:textAppearance="@style/TextAppearance.REPLATE.Caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Savings chart: what the customer saved on their last orders -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="@dimen/elevation_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_savings_chart_title"
                    android:textAppearance="@style/TextAppearance.REPLATE.Subheading" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:text="@string/profile_savings_chart_subtitle"
                    android:textAppearance="@style/TextAppearance.REPLATE.Caption" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chartSavings"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="@dimen/space_1_5"
                    android:contentDescription="@string/profile_savings_chart_cd"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSavingsChartEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1_5"
                    android:gravity="center"
                    android:paddingVertical="@dimen/space_2"
                    android:text="@string/profile_savings_chart_empty"
                    android:textAppearance="@style/TextAppearance.REPLATE.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Menu Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            app:cardBackgroundColor="@color/surface_white"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="@dimen/elevation_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Account Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/profile_account"
                    android:textAppearance="@style/TextAppearance.REPLATE.Subheading" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="@dimen/space_0_5"
                    android:text="@string/profile_account_subtitle"
                    android:textAppearance="@style/TextAppearance.REPLATE.Body" />

                <!-- Menu Items -->
                <!-- My Orders -->
                <LinearLayout
                    android:id="@+id/menuOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/cd_orders"
                        android:src="@drawable/ic_orders"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:text="@string/profile_my_orders"
                        android:textAppearance="@style/TextAppearance.REPLATE.Label" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/cd_arrow_right"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="58dp" android:background="@color/divider" />

                <!-- Favorites -->
                <LinearLayout
                    android:id="@+id/menuFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/cd_favorites"
                        android:src="@drawable/ic_favorite"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:text="@string/profile_favorites"
                        android:textAppearance="@style/TextAppearance.REPLATE.Label" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/cd_arrow_right"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="58dp" android:background="@color/divider" />

                <!-- Notifications -->
                <LinearLayout
                    android:id="@+id/menuNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/cd_open_notifications"
                        android:src="@drawable/ic_notification"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:text="@string/profile_notifications"
                        android:textAppearance="@style/TextAppearance.REPLATE.Label" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/cd_arrow_right"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="58dp" android:background="@color/divider" />

                <!-- Messages -->
                <LinearLayout
                    android:id="@+id/menuMessages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chat_empty"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:text="@string/profile_messages"
                        android:textAppearance="@style/TextAppearance.REPLATE.Label" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="58dp" android:background="@color/divider" />

                <!-- Settings -->
                <LinearLayout
                    android:id="@+id/menuSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/cd_settings"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:text="@string/profile_settings"
                        android:textAppearance="@style/TextAppearance.REPLATE.Label" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/cd_arrow_right"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="58dp" android:background="@color/divider" />

                <!-- Help -->
                <LinearLayout
                    android:id="@+id/menuHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/cd_help"
                        android:src="@drawable/ic_help"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:text="@string/profile_help_support"
                        android:textAppearance="@style/TextAppearance.REPLATE.Label" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/cd_arrow_right"
                        android:src="@drawable/ic_arrow_right" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Logout Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.REPLATE.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_2_5"
            android:text="@string/profile_logout" />

        <!-- Delete Account Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteAccount"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_0_5"
            android:text="@string/profile_delete_account"
            android:textAllCaps="false"
            android:textColor="@color/md_theme_error"
            android:textSize="@dimen/text_sm_compact"
            android:fontFamily="@font/poppins_medium" />

        <!-- App Version -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/space_1"
            android:layout_marginBottom="@dimen/space_4"
            android:text="@string/profile_version"
            android:textAppearance="@style/TextAppearance.REPLATE.Caption" />

    </LinearLayout>

</ScrollView>
