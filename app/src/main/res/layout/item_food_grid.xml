<?xml version="1.0" encoding="utf-8"?>
<!-- Compact food card for the two-column search grid. Same view ids as item_food, so one ViewHolder binds both.
     The Add button sits under the price (full width) so nothing is squeezed on a 320dp phone. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    style="@style/Widget.REPLATE.Card.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_1"
    android:layout_marginVertical="@dimen/space_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/image_height_grid">

            <ImageView
                android:id="@+id/ivFoodImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_food_image"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_food" />

            <View
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_scrim_bottom" />

            <TextView
                android:id="@+id/tvDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_1"
                android:background="@drawable/badge_discount"
                android:paddingHorizontal="@dimen/space_1"
                android:paddingVertical="@dimen/space_0_5"
                android:textAppearance="@style/TextAppearance.REPLATE.Caption"
                android:textColor="@color/white"
                android:textStyle="bold"
                tools:text="@string/food_discount_placeholder" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="@dimen/space_1"
                android:background="@drawable/badge_distance"
                android:drawablePadding="@dimen/space_0_5"
                android:paddingHorizontal="@dimen/space_1"
                android:paddingVertical="@dimen/space_0_5"
                android:textAppearance="@style/TextAppearance.REPLATE.Caption"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_location_small"
                tools:text="@string/food_distance_placeholder" />

            <TextView
                android:id="@+id/tvStockLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_1"
                android:background="@drawable/badge_urgency"
                android:paddingHorizontal="@dimen/space_1"
                android:paddingVertical="@dimen/space_0_5"
                android:textAppearance="@style/TextAppearance.REPLATE.Caption"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Only 2 left" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_1_5">

            <TextView
                android:id="@+id/tvFoodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_sm"
                tools:text="@string/food_name_placeholder" />

            <TextView
                android:id="@+id/tvHotelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs"
                tools:text="@string/food_hotel_placeholder" />

            <TextView
                android:id="@+id/tvPickupTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_xs"
                tools:text="Pickup: 18:00 - 20:00" />

            <TextView
                android:id="@+id/tvOriginalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_xs"
                tools:text="@string/price_original_placeholder" />

            <TextView
                android:id="@+id/tvDiscountedPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/green_primary"
                android:textSize="@dimen/text_md"
                tools:text="@string/price_discounted_placeholder" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ivAddToCart"
                style="@style/Widget.REPLATE.Button.Add"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/food_card_add" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
